{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-structure.dev/schemas/eceef3291d1f/run_options.json",
  "$defs": {
    "AgentMode": {
      "description": "Which agent tasks a run resolves (D6 §2); no setting supplies it. Lifecycle: static.",
      "enum": [
        "wait",
        "complete"
      ],
      "type": "string"
    },
    "AgentReuse": {
      "description": "How M24's digest reads the guideline (D6 §4). Lifecycle: static.",
      "enum": [
        "full",
        "by_unit"
      ],
      "type": "string"
    },
    "GpuMode": {
      "description": "The GPU mode (D6 §5); a result-neutral run option a setting may supply. Lifecycle: static.",
      "enum": [
        "auto",
        "co-resident",
        "exclusive"
      ],
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "The run's options (orchestration §3.4), stored resolved in ops.run.options. agent_mode\ndefaults to wait for kind slice and complete otherwise; no setting supplies it.",
  "properties": {
    "agent_mode": {
      "$ref": "#/$defs/AgentMode"
    },
    "agent_reuse": {
      "$ref": "#/$defs/AgentReuse",
      "default": "full"
    },
    "gpu_mode": {
      "$ref": "#/$defs/GpuMode",
      "default": "auto"
    },
    "corpus": {
      "$ref": "#/$defs/JsonValue"
    },
    "scope": {
      "$ref": "#/$defs/JsonValue"
    },
    "fresh": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "configs": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "method_configs": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "agent_mode",
    "corpus",
    "configs",
    "method_configs"
  ],
  "type": "object"
}
