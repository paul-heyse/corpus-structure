{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-structure.dev/schemas/df024758c4f4/payload.scope.json",
  "$defs": {
    "BindKind": {
      "description": "The kinds of symbol binding (D1 §6.1). Lifecycle: static.",
      "enum": [
        "variable",
        "param_of",
        "param_expr_of",
        "family_param",
        "free",
        "constant",
        "unresolved"
      ],
      "type": "string"
    },
    "MentionAt": {
      "additionalProperties": false,
      "description": "A mention ref with the mention's offsets, so a reused task's refs match by offsets.",
      "properties": {
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "mention_ref": {
          "$ref": "#/$defs/MentionRef"
        }
      },
      "required": [
        "start",
        "end",
        "mention_ref"
      ],
      "type": "object"
    },
    "MentionRef": {
      "additionalProperties": false,
      "description": "A mention by its task and ordinal; the task is absent inside the same task.",
      "properties": {
        "task": {
          "type": "integer"
        },
        "ordinal": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ordinal"
      ],
      "type": "object"
    },
    "ScopeExtent": {
      "description": "How far a supposition reaches beyond its statement. Lifecycle: static.",
      "enum": [
        "statement",
        "section",
        "document"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A binding site and its scope (M13).",
  "properties": {
    "start": {
      "minimum": 0,
      "type": "integer"
    },
    "end": {
      "minimum": 0,
      "type": "integer"
    },
    "mention_ref": {
      "$ref": "#/$defs/MentionRef"
    },
    "binding_site": {
      "$ref": "#/$defs/MentionAt"
    },
    "scope_segment": {
      "minLength": 1,
      "type": "string"
    },
    "extent": {
      "$ref": "#/$defs/ScopeExtent"
    },
    "binding": {
      "$ref": "#/$defs/BindKind"
    },
    "reopens": {
      "$ref": "#/$defs/MentionAt"
    }
  },
  "required": [
    "start",
    "end",
    "mention_ref",
    "binding_site",
    "scope_segment",
    "extent"
  ],
  "type": "object"
}
