{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-structure.dev/schemas/aec8922d939e/payload.mention.json",
  "$defs": {
    "JsonValue": {},
    "LabelScore": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "label",
        "score"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "start": {
      "minimum": 0,
      "type": "integer"
    },
    "end": {
      "minimum": 0,
      "type": "integer"
    },
    "label": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "attributes": {
      "additionalProperties": {
        "$ref": "#/$defs/LabelScore"
      },
      "type": "object"
    },
    "math_ref": {
      "pattern": "^seg:[0-9a-f]{32}$",
      "type": "string"
    },
    "math": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    }
  },
  "required": [
    "start",
    "end",
    "label",
    "text"
  ],
  "type": "object"
}
