{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-structure.dev/schemas/89b083ed4152/payload.link.json",
  "$defs": {
    "JsonValue": {},
    "MentionRef": {
      "additionalProperties": false,
      "description": "A mention by its task and ordinal; the task is absent inside the same task.",
      "properties": {
        "task": {
          "type": "integer"
        },
        "ordinal": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ordinal"
      ],
      "type": "object"
    },
    "NewEntity": {
      "additionalProperties": false,
      "description": "A new entity a link proposes.",
      "properties": {
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "label"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An entity-link candidate: the mention (M14) or the pair (M15), and the candidate entity's key\nor the new entity it proposes, exactly one of each.",
  "properties": {
    "mention_ref": {
      "$ref": "#/$defs/MentionRef"
    },
    "pair": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "type": "array"
    },
    "candidate": {
      "minLength": 1,
      "type": "string"
    },
    "new": {
      "$ref": "#/$defs/NewEntity"
    },
    "score": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "features": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "rank": {
      "type": "integer"
    }
  },
  "required": [
    "score",
    "features"
  ],
  "type": "object"
}
