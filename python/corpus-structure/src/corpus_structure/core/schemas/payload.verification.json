{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-structure.dev/schemas/ba316957d50d/payload.verification.json",
  "$defs": {
    "JsonValue": {},
    "RuleSeverity": {
      "description": "`meta.schema_rule.severity`. Lifecycle: static.",
      "enum": [
        "warning",
        "error"
      ],
      "type": "string"
    },
    "VerificationDetail": {
      "additionalProperties": false,
      "description": "What M19 writes for a failing rule.",
      "properties": {
        "rule": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/RuleSeverity"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "VerificationVerdict": {
      "description": "A verifier's verdict on a claim (M19-M21). Lifecycle: static.",
      "enum": [
        "consistent",
        "refuted",
        "not_checkable"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A verifier's verdict on a claim.",
  "properties": {
    "claim_key": {
      "type": "string"
    },
    "verifier": {
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/VerificationVerdict"
    },
    "detail": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationDetail"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "counterexample": {
      "$ref": "#/$defs/JsonValue"
    }
  },
  "required": [
    "claim_key",
    "verifier",
    "verdict"
  ],
  "type": "object"
}
