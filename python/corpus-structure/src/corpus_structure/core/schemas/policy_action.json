{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-structure.dev/schemas/ba316957d50d/policy_action.json",
  "$defs": {
    "PolicyThen": {
      "description": "What a policy rule's chain does after its action (D3 §6.3). Lifecycle: static.",
      "enum": [
        "stop",
        "continue"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "`ops.policy_rule.action`: a named configuration `<method>/<name>`, a limit, then.",
  "properties": {
    "method": {
      "pattern": "^[a-z][a-z0-9_.]*/[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "limit": {
      "minimum": 1,
      "type": "integer"
    },
    "then": {
      "$ref": "#/$defs/PolicyThen"
    }
  },
  "required": [
    "method",
    "then"
  ],
  "type": "object"
}
