  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://corpus-structure.dev/schemas/a59196c4a894/payload.judgment.json",
    "$defs": {
      "JudgmentConfidence": {
        "description": "A judge's stated confidence. Lifecycle: static.",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "type": "string"
      },
      "JudgmentDecision": {
        "description": "A judgment's decision (M16, the agent, a human). Lifecycle: static.",
        "enum": [
          "accept",
          "reject",
          "choose",
          "merge",
          "split",
          "unsure"
        ],
        "type": "string"
      },
      "JudgmentTarget": {
        "additionalProperties": false,
        "description": "What a judgment is about: an observation by its id's decimal text, or a claim or group by its\nkey with that key's scheme (readers compare keys only within one scheme or through a carry-over\nmap; foundations \u00a73.6).",
        "properties": {
          "kind": {
            "$ref": "#/$defs/JudgmentTargetKind"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "key_scheme": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "type": "object"
      },
      "JudgmentTargetKind": {
        "description": "What a judgment is about (JudgmentTarget.kind, D3 \u00a76.2). Lifecycle: static.",
        "enum": [
          "observation",
          "claim",
          "alternative_group",
          "identity_group"
        ],
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "A decision under a guideline version.",
    "properties": {
      "target": {
        "$ref": "#/$defs/JudgmentTarget"
      },
      "decision": {
        "$ref": "#/$defs/JudgmentDecision"
      },
      "rationale": {
        "type": "string"
      },
      "guideline_version": {
        "type": "string"
      },
      "chosen": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "faithful": {
        "type": "boolean"
      },
      "confidence": {
        "$ref": "#/$defs/JudgmentConfidence"
      }
    },
    "required": [
      "target",
      "decision",
      "rationale",
      "guideline_version"
    ],
    "type": "object"
  }
}
