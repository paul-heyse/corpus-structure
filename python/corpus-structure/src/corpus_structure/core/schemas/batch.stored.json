{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-structure.dev/schemas/aec8922d939e/batch.stored.json",
  "$defs": {
    "AlternativeItem": {
      "additionalProperties": false,
      "properties": {
        "refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "refs",
        "reason"
      ],
      "type": "object"
    },
    "BindKind": {
      "description": "The kinds of symbol binding (D1 §6.1). Lifecycle: static.",
      "enum": [
        "variable",
        "param_of",
        "param_expr_of",
        "family_param",
        "free",
        "constant",
        "unresolved"
      ],
      "type": "string"
    },
    "BoolValue": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "bool",
          "type": "string"
        },
        "v": {
          "type": "boolean"
        }
      },
      "required": [
        "t",
        "v"
      ],
      "type": "object"
    },
    "ClaimNode": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "claim",
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "op",
        "ref"
      ],
      "type": "object"
    },
    "CmpNode": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "cmp",
          "type": "string"
        },
        "rel": {
          "$ref": "#/$defs/Relation"
        },
        "lhs": {
          "$ref": "#/$defs/Formula"
        },
        "rhs": {
          "$ref": "#/$defs/Formula"
        }
      },
      "required": [
        "op",
        "rel",
        "lhs",
        "rhs"
      ],
      "type": "object"
    },
    "DateValue": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "date",
          "type": "string"
        },
        "v": {
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})?)?)?)?$",
          "type": "string"
        }
      },
      "required": [
        "t",
        "v"
      ],
      "type": "object"
    },
    "EntityExtent": {
      "description": "How far a local entity reaches. Lifecycle: static.",
      "enum": [
        "statement",
        "section"
      ],
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "description": "The one entity-reference shape: a local ref in a batch, an entity key once stored.",
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "EntityScope": {
      "description": "Whether an entity is global or local to a scope segment (D1 §4.2). Lifecycle: static.",
      "enum": [
        "global",
        "local"
      ],
      "type": "string"
    },
    "Establishment": {
      "description": "How a claim was established (D5 §9): a claim item's and `kb.claim.establishment`. Lifecycle:\nstatic.",
      "enum": [
        "stated",
        "derived",
        "agent_asserted"
      ],
      "type": "string"
    },
    "EvidenceRole": {
      "description": "The part an evidence span plays for its claim (guideline §10.8). Lifecycle: static.",
      "enum": [
        "primary",
        "supporting",
        "condition",
        "definition"
      ],
      "type": "string"
    },
    "Formula": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "formula",
          "type": "string"
        },
        "latex": {
          "type": "string"
        },
        "symbols": {
          "additionalProperties": {
            "$ref": "#/$defs/SymbolBinding"
          },
          "type": "object"
        },
        "sympy": {
          "type": "string"
        },
        "parse": {
          "$ref": "#/$defs/ParseOutcome"
        }
      },
      "required": [
        "t",
        "latex"
      ],
      "type": "object"
    },
    "IntervalValue": {
      "additionalProperties": false,
      "description": "An interval; an absent bound is unbounded.",
      "properties": {
        "t": {
          "const": "interval",
          "type": "string"
        },
        "start": {
          "discriminator": {
            "mapping": {
              "date": "#/$defs/DateValue",
              "formula": "#/$defs/Formula",
              "number": "#/$defs/NumberValue"
            },
            "propertyName": "t"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumberValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/Formula"
            }
          ]
        },
        "end": {
          "discriminator": {
            "mapping": {
              "date": "#/$defs/DateValue",
              "formula": "#/$defs/Formula",
              "number": "#/$defs/NumberValue"
            },
            "propertyName": "t"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NumberValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/Formula"
            }
          ]
        },
        "start_incl": {
          "type": "boolean"
        },
        "end_incl": {
          "type": "boolean"
        }
      },
      "required": [
        "t"
      ],
      "type": "object"
    },
    "JsonValue": {},
    "MemberNode": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "member",
          "type": "string"
        },
        "x": {
          "$ref": "#/$defs/Formula"
        },
        "set": {
          "$ref": "#/$defs/SetValue"
        }
      },
      "required": [
        "op",
        "x",
        "set"
      ],
      "type": "object"
    },
    "NumberValue": {
      "additionalProperties": false,
      "description": "A number as its D1 §6.2 canonical decimal; `unit` and `basis` as the source states them.",
      "properties": {
        "t": {
          "const": "number",
          "type": "string"
        },
        "v": {
          "pattern": "^(?:0|-?(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$",
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "v"
      ],
      "type": "object"
    },
    "ParseOutcome": {
      "description": "The math grammar's parse outcome for a formula or set value (D4 M11). Lifecycle: static.",
      "enum": [
        "ok",
        "partial",
        "ambiguous",
        "failed"
      ],
      "type": "string"
    },
    "Polarity": {
      "description": "Whether a claim is stated or denied. Lifecycle: static.",
      "enum": [
        "positive",
        "negative"
      ],
      "type": "string"
    },
    "PredNode": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "pred",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/EntityRef"
              },
              {
                "$ref": "#/$defs/Formula"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "op",
        "name",
        "args"
      ],
      "type": "object"
    },
    "Relation": {
      "description": "The relation of a cmp condition node (D1 §7). Lifecycle: static.",
      "enum": [
        "<",
        "<=",
        "=",
        "!=",
        ">",
        ">="
      ],
      "type": "string"
    },
    "ScopeExtent": {
      "description": "How far a supposition reaches beyond its statement. Lifecycle: static.",
      "enum": [
        "statement",
        "section",
        "document"
      ],
      "type": "string"
    },
    "SetValue": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "set",
          "type": "string"
        },
        "latex": {
          "type": "string"
        },
        "symbols": {
          "additionalProperties": {
            "$ref": "#/$defs/SymbolBinding"
          },
          "type": "object"
        },
        "sympy": {
          "type": "string"
        },
        "parse": {
          "$ref": "#/$defs/ParseOutcome"
        }
      },
      "required": [
        "t",
        "latex"
      ],
      "type": "object"
    },
    "StatementRole": {
      "description": "The part a claim plays in its statement (guideline §10.3). Lifecycle: static.",
      "enum": [
        "premise",
        "conclusion",
        "definiens",
        "restriction",
        "example_value"
      ],
      "type": "string"
    },
    "StoredAnd": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "and",
          "type": "string"
        },
        "args": {
          "items": {
            "$ref": "#/$defs/StoredCondition"
          },
          "type": "array"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "type": "object"
    },
    "StoredClaim": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "minLength": 1,
          "type": "string"
        },
        "predicate": {
          "pattern": "^[a-z][a-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "statement_role": {
          "$ref": "#/$defs/StatementRole"
        },
        "establishment": {
          "$ref": "#/$defs/Establishment",
          "default": "stated"
        },
        "derived_from": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "rule": {
          "minLength": 1,
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "$ref": "#/$defs/StoredValue"
            }
          ]
        },
        "qualifiers": {
          "$ref": "#/$defs/StoredQualifiers"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/StoredEvidence"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "local_ref",
        "predicate",
        "subject",
        "object",
        "evidence"
      ],
      "type": "object"
    },
    "StoredCondition": {
      "discriminator": {
        "mapping": {
          "and": "#/$defs/StoredAnd",
          "claim": "#/$defs/ClaimNode",
          "cmp": "#/$defs/CmpNode",
          "forall": "#/$defs/StoredForall",
          "member": "#/$defs/MemberNode",
          "not": "#/$defs/StoredNot",
          "or": "#/$defs/StoredOr",
          "phrase": "#/$defs/StoredPhraseNode",
          "pred": "#/$defs/PredNode",
          "unsupported": "#/$defs/StoredUnsupportedNode"
        },
        "propertyName": "op"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StoredAnd"
        },
        {
          "$ref": "#/$defs/StoredOr"
        },
        {
          "$ref": "#/$defs/StoredNot"
        },
        {
          "$ref": "#/$defs/StoredForall"
        },
        {
          "$ref": "#/$defs/ClaimNode"
        },
        {
          "$ref": "#/$defs/MemberNode"
        },
        {
          "$ref": "#/$defs/CmpNode"
        },
        {
          "$ref": "#/$defs/PredNode"
        },
        {
          "$ref": "#/$defs/StoredPhraseNode"
        },
        {
          "$ref": "#/$defs/StoredUnsupportedNode"
        }
      ]
    },
    "StoredDescriptor": {
      "additionalProperties": false,
      "description": "A stored external reference's citing text: the quote's located span (`coarse` when only its\nsentence was located) and the link target.",
      "properties": {
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "coarse": {
          "type": "boolean"
        },
        "target": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "StoredEntity": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EntityScope"
        },
        "extent": {
          "$ref": "#/$defs/EntityExtent"
        },
        "symbol": {
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "identity": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "scope_segment": {
          "type": "string"
        }
      },
      "required": [
        "local_ref",
        "type",
        "label",
        "scope"
      ],
      "type": "object"
    },
    "StoredEnumValue": {
      "additionalProperties": false,
      "description": "The stored enum value: the enum by its prefixed name (`stat:ParameterRole`).",
      "properties": {
        "t": {
          "const": "enum",
          "type": "string"
        },
        "enum": {
          "pattern": "^[a-z][a-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "v": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "enum",
        "v"
      ],
      "type": "object"
    },
    "StoredEvidence": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "coarse": {
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "role"
      ],
      "type": "object"
    },
    "StoredForall": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "forall",
          "type": "string"
        },
        "var": {
          "type": "string"
        },
        "set": {
          "$ref": "#/$defs/SetValue"
        },
        "body": {
          "$ref": "#/$defs/StoredCondition"
        }
      },
      "required": [
        "op",
        "var",
        "set",
        "body"
      ],
      "type": "object"
    },
    "StoredNot": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "not",
          "type": "string"
        },
        "arg": {
          "$ref": "#/$defs/StoredCondition"
        }
      },
      "required": [
        "op",
        "arg"
      ],
      "type": "object"
    },
    "StoredOr": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "or",
          "type": "string"
        },
        "args": {
          "items": {
            "$ref": "#/$defs/StoredCondition"
          },
          "type": "array"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "type": "object"
    },
    "StoredOutside": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "minLength": 1,
          "type": "string"
        },
        "anchor": {
          "const": "outside",
          "type": "string"
        },
        "descriptor": {
          "$ref": "#/$defs/StoredDescriptor"
        }
      },
      "required": [
        "local_ref",
        "anchor",
        "descriptor"
      ],
      "type": "object"
    },
    "StoredPhrase": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "phrase",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "coarse": {
          "type": "boolean"
        }
      },
      "required": [
        "t",
        "text",
        "start",
        "end"
      ],
      "type": "object"
    },
    "StoredPhraseNode": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "phrase",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "coarse": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "text",
        "start",
        "end"
      ],
      "type": "object"
    },
    "StoredQualifiers": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "The stored qualifiers: the core ones as `core:<name>`, schema qualifiers by prefixed name.\n\nAttributes keep the local names (`q.modality`); validation and dumps use the prefixed ones.",
      "properties": {
        "core:modality": {
          "default": "asserted",
          "pattern": "^[a-z][a-z0-9_]*(:[a-z][a-z0-9_]*)?$",
          "type": "string"
        },
        "core:polarity": {
          "$ref": "#/$defs/Polarity",
          "default": "positive"
        },
        "core:hedge": {
          "$ref": "#/$defs/StoredPhrase"
        },
        "core:attribution": {
          "$ref": "#/$defs/EntityRef"
        },
        "core:conditions": {
          "$ref": "#/$defs/StoredCondition"
        },
        "core:scope": {
          "$ref": "#/$defs/StoredScope"
        },
        "core:valid_time": {
          "$ref": "#/$defs/IntervalValue"
        }
      },
      "type": "object"
    },
    "StoredScope": {
      "additionalProperties": false,
      "description": "The stored scope qualifier: the extent and the segment it resolves to on the rendition.",
      "properties": {
        "extent": {
          "$ref": "#/$defs/ScopeExtent"
        },
        "segment": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "extent",
        "segment"
      ],
      "type": "object"
    },
    "StoredStatement": {
      "additionalProperties": false,
      "properties": {
        "local_ref": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "anchor": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "local_ref",
        "kind",
        "anchor"
      ],
      "type": "object"
    },
    "StoredStatementItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/StoredStatement"
        },
        {
          "$ref": "#/$defs/StoredOutside"
        }
      ]
    },
    "StoredUnsupported": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "local_ref": {
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "coarse": {
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "local_ref",
        "reason"
      ],
      "type": "object"
    },
    "StoredUnsupportedNode": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "unsupported",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "coarse": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "text",
        "start",
        "end",
        "reason"
      ],
      "type": "object"
    },
    "StoredValue": {
      "discriminator": {
        "mapping": {
          "bool": "#/$defs/BoolValue",
          "date": "#/$defs/DateValue",
          "enum": "#/$defs/StoredEnumValue",
          "formula": "#/$defs/Formula",
          "interval": "#/$defs/IntervalValue",
          "number": "#/$defs/NumberValue",
          "phrase": "#/$defs/StoredPhrase",
          "set": "#/$defs/SetValue",
          "text": "#/$defs/TextValue"
        },
        "propertyName": "t"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TextValue"
        },
        {
          "$ref": "#/$defs/NumberValue"
        },
        {
          "$ref": "#/$defs/BoolValue"
        },
        {
          "$ref": "#/$defs/StoredEnumValue"
        },
        {
          "$ref": "#/$defs/Formula"
        },
        {
          "$ref": "#/$defs/SetValue"
        },
        {
          "$ref": "#/$defs/DateValue"
        },
        {
          "$ref": "#/$defs/IntervalValue"
        },
        {
          "$ref": "#/$defs/StoredPhrase"
        }
      ]
    },
    "SymbolBinding": {
      "additionalProperties": false,
      "description": "How one symbol of a formula is bound (D1 §6.1); the kind decides which fields it has.",
      "properties": {
        "bind": {
          "$ref": "#/$defs/BindKind"
        },
        "entity": {
          "minLength": 1,
