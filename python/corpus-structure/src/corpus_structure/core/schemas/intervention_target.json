{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "InterventionTargetKind": {
      "description": "What an intervention acts on (InterventionTarget.kind, D3 §6.3). Lifecycle: static.",
      "enum": [
        "unit",
        "claim",
        "alternative_group",
        "golden_unit",
        "schema",
        "guideline",
        "policy",
        "run"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "`ops.intervention.target`; a `promotion` targets the run it promotes.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/InterventionTargetKind"
    },
    "ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    }
  },
  "required": [
    "kind",
    "ref"
  ],
  "type": "object"
}
