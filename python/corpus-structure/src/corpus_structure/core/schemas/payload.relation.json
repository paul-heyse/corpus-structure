{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-structure.dev/schemas/68de8f9a1d3d/payload.relation.json",
  "$defs": {
    "LabelledSpan": {
      "additionalProperties": false,
      "description": "A labelled span of a relation.",
      "properties": {
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "label"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A relation between two spans.",
  "properties": {
    "label": {
      "type": "string"
    },
    "head": {
      "$ref": "#/$defs/LabelledSpan"
    },
    "tail": {
      "$ref": "#/$defs/LabelledSpan"
    },
    "joint": {
      "type": "boolean"
    },
    "feasible": {
      "type": "boolean"
    }
  },
  "required": [
    "label",
    "head",
    "tail"
  ],
  "type": "object"
}
