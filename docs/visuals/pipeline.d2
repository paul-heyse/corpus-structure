direction: down

classes: {
  stage: {
    shape: rectangle
    style: {
      font-size: 23
      border-radius: 10
    }
  }
}

source: "Source documents\nProvenance follows each output\nAssessment applies at every stage" {
  class: stage
  style.bold: true
}

extract: "01  Extract observations\nLocate definitions, roles and cues\nOutput: located observations" {class: stage}
compose: "02  Compose local meaning\nAttach roles, conditions and antecedents\nOutput: qualified components" {class: stage}
connect: "03  Connect related material\nRetrieve candidates and select typed links\nOutput: witnessed connections" {class: stage}
assemble: "04  Assemble knowledge\nGroup supported material and compare readings\nOutput: dossiers, comparisons and gaps" {class: stage}

source -> extract: "source spans"
extract -> compose: "located cues"
compose -> connect: "qualified context"
connect -> assemble: "supported links"
