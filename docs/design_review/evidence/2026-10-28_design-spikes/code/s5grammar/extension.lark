// ===== S5-A extended grammar extension (code/s5grammar/extension.lark), assembled by s5_extensions.py =====
// mathgrammar/extension.lark (the frozen I-R2 extension) followed by the S5 blocks kept in step 3,
// in order: 01, 02, 03, 04, 05, 06, 07, 09, 10, 11, 12, 13, 14, 15, 16, 17, 20, 21, 22, 24, 25, 26, 18, 19, 27, 28, 29, 30, 31, 33, 34, 35. Build with Lark edit_terminals (s5grammar.whole_name) and
// ordered_sets=True; no regex-generated %override lines.

// ===== corpus-structure extension of SymPy 1.14's latex.lark (ADR-0009, instruments revisit I-R1) =====
// Appended to the shipped grammar text, which is read unedited from the installed package.
// Only %extend / %override and new rules or terminals appear here. Source facts (the rendition's
// macro names) are not written here: mathgrammar.build appends a generated block that defines
// GEN_SET, GEN_OP and GEN_STYLE from the macro table. Every command terminal defined here matches
// whole command names only (a letter may not follow), so \P never matches the start of \Phi.

// ---------------------------------------------------------------- letters and constants
// Greek letters, whole names only; adds the letters SymPy lacks (sigma, iota, upper case) and \ell.
%override GREEK_SYMBOL: /\\(?:alpha|beta|gamma|delta|epsilon|varepsilon|zeta|eta|theta|vartheta|iota|kappa|lambda|mu|nu|xi|rho|varrho|sigma|varsigma|tau|upsilon|phi|varphi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Upsilon|Phi|Psi|Omega|ell)(?![A-Za-z])/
CMD_PI: /\\pi(?![A-Za-z])/
pi_constant: CMD_PI

// ---------------------------------------------------------------- relations, bars, signs
%extend LT: /\\lt(?![A-Za-z])/
%extend GT: /\\gt(?![A-Za-z])/
%extend BAR: /\\(?:lvert|rvert|vert|mid)(?![A-Za-z])/
CMD_PM: /\\(?:pm|mp)(?![A-Za-z])/
plus_minus: _expression CMD_PM _expression_mul
    | CMD_PM _expression_mul
%extend _expression: plus_minus

// ---------------------------------------------------------------- sub- and superscripts as structure
// SymPy reads X_1, \mu_1 as single regex terminals (LATIN_SYMBOL_WITH_LATIN_SUBSCRIPT, ...), which
// hide the subscript and reject \sigma_{X_1}, X_{(n)}. They are replaced by rules.
%override _one_letter_symbol: SYMBOL | GREEK_SYMBOL_WITH_PRIMES | sub_symbol
sub_symbol: _sym_base UNDERSCORE _script_arg
_sym_base: SYMBOL | GREEK_SYMBOL_WITH_PRIMES
_script_arg: SYMBOL | DIGIT | GREEK_SYMBOL_WITH_PRIMES | script_group
script_group: L_BRACE list_of_expressions R_BRACE
%override symbol_prime: sub_symbol PRIMES
// superscript written before the subscript: \sigma^2_X
sup_sub: _sym_base CARET _expression_core UNDERSCORE _script_arg
%extend _expression_power: sup_sub

// ---------------------------------------------------------------- implicit multiplication
// SymPy lists particular adjacent pairs (a symbol or number before a factor, a parenthesized group
// before a group or symbol, a function before a function, a fraction before a factor), so
// b^2 \sigma^2, (r_1 + r_2) \lambda(A), \binom{n}{k} p^k and \sqrt{2\pi} \sigma fail. Replaced by
// the general rule: any power-level factor followed by a product (right-associative). The
// application-or-product question for symbol(...) is left to the ambiguity rules (api).
%override adjacent_expressions: _expression_power _expression_mul
%extend _atomic_expr: pi_constant | ellipsis | styled
%extend _expression_func: group_square_brackets | norm | lim_infsup | extremum

// sizing commands are presentation, like \left / \right: their %ignore is generated by
// mathgrammar.build from the token form's declared drop list (printer.DROP_LIST, D1 §6.2)

// ---------------------------------------------------------------- other operators (parse; no SymPy value)
NORM_BAR: "\\|" | /\\(?:lVert|rVert|Vert)(?![A-Za-z])/
norm: NORM_BAR _expression NORM_BAR (UNDERSCORE _script_arg)?
FUNC_LIMINFSUP: /\\(?:liminf|limsup)(?![A-Za-z])/
lim_infsup: FUNC_LIMINFSUP UNDERSCORE group_curly_parentheses_lim _expression
FUNC_SUPINF: /\\(?:sup|inf|argmax|argmin)(?![A-Za-z])/
extremum: (FUNC_SUPINF | FUNC_MAX | FUNC_MIN) UNDERSCORE _script_arg _expression
    | FUNC_SUPINF _expression
set_integral: FUNC_INT UNDERSCORE _expression_core _expression DIFFERENTIAL_SYMBOL _one_letter_symbol
%extend _integral: set_integral
// sums, products and integrals indexed by a set: \sum_{x \in S} f(x), \int_{\R^2} g
set_indexed: (FUNC_SUM | FUNC_PROD | FUNC_INT) UNDERSCORE L_BRACE (member | set_expr) R_BRACE _expression
%extend _expression_mul: set_indexed
CMD_WEDGEVEE: /\\(?:wedge|vee)(?![A-Za-z])/
wedge_vee: _expression_mul CMD_WEDGEVEE _expression_power
%extend _expression_mul: wedge_vee

// ---------------------------------------------------------------- ellipses
ELLIPSIS: /\\(?:ldots|cdots|dots|dotsc|dotsb|dotsm)(?![A-Za-z])/ | "..."
ellipsis: ELLIPSIS

// ---------------------------------------------------------------- typeface wrappers (transparent)
CMD_STYLE: /\\(?:mathscr|mathcal|mathbf|boldsymbol|bm|mathsf|mathfrak)(?![A-Za-z])/
CMD_MATHRM: /\\mathrm(?![A-Za-z])/
styled: (CMD_STYLE | GEN_STYLE) (SYMBOL | GREEK_SYMBOL_WITH_PRIMES | L_BRACE _expression R_BRACE)
    | CMD_MATHRM (SYMBOL | L_BRACE SYMBOL R_BRACE)

// ---------------------------------------------------------------- operators applied to (...) or [...]
// \mathbb{E}(X), \text{var}(X), \operatorname{cov}(X, Y), and the rendition's operator macros
// (GEN_OP: \E, \var, ... classified from macro bodies). P(X | Y) style conditions inside.
CMD_MATHBB: /\\mathbb(?![A-Za-z])/
CMD_OPWORD: /\\(?:text|operatorname|textrm|mathrm)(?![A-Za-z])/
OPWORD: /[A-Za-z]{2,}/
BB_OP_LETTER: /[ABD-MOPS-Y]/
BB_SET_LETTER: /[CNQRZ]/
op_name: GEN_OP
    | CMD_MATHBB L_BRACE BB_OP_LETTER R_BRACE
    | CMD_OPWORD L_BRACE OPWORD R_BRACE
op_applied: op_name L_PAREN _op_args R_PAREN
    | op_name L_BRACKET _op_args R_BRACKET
_op_args: list_of_expressions | _cond_item | cond_list | conditional
_cond_item: _relation | member | rel_chain
cond_list: _cond_item ("," _cond_item)+
conditional: _cond_side BAR _cond_side
_cond_side: list_of_expressions | _cond_item | cond_list
%extend _function: op_applied

// ---------------------------------------------------------------- sets
CMD_SETMINUS: /\\(?:setminus|smallsetminus|backslash)(?![A-Za-z])/
CMD_CUP: /\\cup(?![A-Za-z])/
CMD_CAP: /\\cap(?![A-Za-z])/
CMD_IN: /\\in(?![A-Za-z])/
CMD_NOTIN: /\\notin(?![A-Za-z])/
CMD_SUBSET: /\\(?:subseteq|subset|supseteq|supset)(?![A-Za-z])/
CMD_EMPTYSET: /\\(?:emptyset|varnothing)(?![A-Za-z])/
set_const: _set_name set_sign? (CARET _expression_core)?
_set_name: GEN_SET | CMD_MATHBB L_BRACE BB_SET_LETTER R_BRACE
set_sign: (UNDERSCORE | CARET) (ADD | SUB | L_BRACE (ADD | SUB) R_BRACE)
interval: (L_PAREN | L_BRACKET) _expression "," _expression (R_PAREN | R_BRACKET)
set_list: L_BRACE_LITERAL list_of_expressions R_BRACE_LITERAL
set_builder: L_BRACE_LITERAL (_expression | member) (COLON | BAR) _builder_cond R_BRACE_LITERAL
_builder_cond: _cond_item | cond_list
set_event: L_BRACE_LITERAL (_cond_item | cond_list) R_BRACE_LITERAL
empty_set: CMD_EMPTYSET
set_named: _one_letter_symbol | styled
set_group: L_PAREN set_expr R_PAREN
?set_atom: set_const | interval | set_list | set_builder | set_event | empty_set | set_named | set_group
?set_expr: set_atom | set_minus | set_union | set_intersection | set_product
set_minus: set_expr CMD_SETMINUS set_atom
set_union: set_expr CMD_CUP set_atom
set_intersection: set_expr CMD_CAP set_atom
set_product: set_expr CMD_TIMES set_atom

// ---------------------------------------------------------------- typed start symbols
member: list_of_expressions (CMD_IN | CMD_NOTIN) set_expr
// chains: a = b = c, 0 < p \le 1, f(x) = g(x) \le h(x)
rel_chain: _expression _rel_op _expression (_rel_op _expression)+
_rel_op: EQUAL | NOT_EQUAL | LT | LTE | GT | GTE
subset_rel: set_expr CMD_SUBSET set_expr
// statements of convergence and distribution, and other relations: parse, no SymPy value
CMD_ARROW_REL: /\\(?:uparrow|downarrow|nearrow|searrow)(?![A-Za-z])/
CMD_OTHER_REL: /\\(?:sim|approx|equiv|propto|simeq|cong)(?![A-Za-z])/
approach: _expression (LIM_APPROACH_SYM | CMD_ARROW_REL) _expression
other_rel: _expression CMD_OTHER_REL _expression
formula: _expression | eq
// an equation is a formula (D1 §6: expression or equation), so relation holds the others
relation: ne | lt | lte | gt | gte | rel_chain | subset_rel | approach | other_rel
// several values separated by commas (\quad is ignored): "f(x) = ..., \quad x \in [0, 1]"
value_list: _list_item ("," _list_item)+
_list_item: formula | relation | member
any_value: formula | relation | member | set_expr | value_list

// S5-01 X_\infty, F_\infty(x), x_\infty: \infty as a subscript
%extend _script_arg: CMD_INFTY

// S5-02 tuples: (X_1, X_2, \ldots, X_n), (\Omega, \ms F, \P), (x, y) \in S, (S, \ms S) = (\Omega, \ms F).
// Only at value level (a formula, an equation side, a membership's element), never a factor, so
// f(x, y) gains no product reading. A two-component tuple alone stays ambiguous with an interval.
tuple: L_PAREN _tuple_item ("," _tuple_item)+ R_PAREN
_tuple_item: _expression | op_name
%extend formula: tuple | tuple EQUAL (tuple | _expression) | _expression EQUAL tuple
%extend member: tuple (CMD_IN | CMD_NOTIN) set_expr

// S5-03 x \mapsto f(x), A \mapsto \P(A \mid E): a map written by its rule (parse; no SymPy value)
CMD_MAPSTO: /\\mapsto(?![A-Za-z])/
maps_to: _expression CMD_MAPSTO (_expression | eq)
%extend relation: maps_to

// S5-04 f: S \to \R, F: \R \to [0, 1], u: \{0,1\}^n \to \{0, 1\}: a function's domain and codomain
fn_signature: _expression COLON set_expr LIM_APPROACH_SYM set_expr
%extend relation: fn_signature

// S5-05 \P, \E, \var, \pm, \ln alone: an operator named, not applied (a whole value only)
op_alone: op_name | CMD_PM | FUNC_LN | FUNC_LOG | FUNC_EXP | FUNC_SIN | FUNC_COS | FUNC_TAN
%extend any_value: op_alone

// S5-06 f(x \mid E), L(Y \mid X = x), g(x \mid X \in B): a symbol applied to a conditional argument
cond_applied: _one_letter_symbol L_PAREN conditional R_PAREN
%extend _function: cond_applied

// S5-07 P(\{x\}), \P(\{X = x\} \cap E), P(\{x\} \mid D), \P(A \cap B): a set (not a lone symbol or interval)
// as the argument of an operator or of a symbol
_set_arg: set_list | set_builder | set_event | set_const | empty_set | set_minus | set_union | set_intersection | set_product
%extend _op_args: _set_arg
%extend _cond_side: _set_arg
set_applied: _one_letter_symbol L_PAREN _set_arg R_PAREN
    | _one_letter_symbol L_PAREN _set_arg BAR _cond_side R_PAREN
%extend _function: set_applied

// S5-09 \min\{X_1, X_2\}, \max\{n \in \N: T_n \le t\}, \inf\{x \in \R: F(x) \gt p\}: an extremum over a set
extremum_set: (FUNC_SUPINF | FUNC_MAX | FUNC_MIN) (set_list | set_builder)
%extend _expression_func: extremum_set

// S5-10 \ms R_1, \mathscr S_i, \bs X_n: a styled symbol with a subscript
%extend _sym_base: styled

// S5-11 \P_p(X = 1), \E_\theta(X): an operator with a subscript, applied
op_applied_sub: op_name UNDERSCORE _script_arg (L_PAREN _op_args R_PAREN | L_BRACKET _op_args R_BRACKET)
%extend _function: op_applied_sub

// S5-12 \{0, 1\}^n, [0, 1]^2, (0, \infty)^2, \N_+^*, and B^c, \ms R^n in a set position
set_power: (set_list | interval | set_group | set_builder) CARET (_expression_core | MUL)
%extend set_atom: set_power
%extend set_const: _set_name set_sign? CARET (MUL | CMD_ASTERISK)
named_power: set_named CARET (_expression_core | MUL)
%extend member: list_of_expressions (CMD_IN | CMD_NOTIN) named_power

// S5-13 \E(Z) = \frac{1280}{21} \approx 60.95: \approx, \sim, \equiv in a chain of relations
%extend _rel_op: CMD_OTHER_REL

// S5-14 \#(A), \#(S), \#: counting measure as an operator
CMD_HASH: "\\#"
%extend op_name: CMD_HASH

// S5-15 \E(X; A), \E[\E(X \mid \mathscr G); A]: an operator's argument restricted to an event
op_semi: _cond_side ";" _cond_side
%extend _op_args: op_semi

// S5-16 x^+, F(x^+), g_n^+, X^-, M_+(t), \chi_+: a sign as a superscript or subscript
%extend _script_arg: ADD | SUB
sign_power: _expression_func CARET (ADD | SUB)
%extend _expression_power: sign_power

// S5-17 \ln x \bigg|_1^\infty, -x \ln x \biggm|_0^1: an evaluation bar (sizing dropped)
eval_bar: _expression BAR (UNDERSCORE _expression_core CARET _expression_core | CARET _expression_core UNDERSCORE _expression_core)
%extend _expression: eval_bar

// S5-20 (S5-08 refined: 08 made R = S \times T ambiguous) \ms S = \{A \in \ms R^n: A \subseteq S\},
// C_p \cap C_q = \emptyset, \{X = a\} = \{X \le a\} \setminus \{X \lt a\}, S = [0, 1]^3: an equation of sets
// whose right side is a written-out set (a set operation only when an operand is written out)
_set_written: set_list | set_builder | set_event | set_const | empty_set
_set_rhs2: _set_written | set_minus | set_union | set_intersection | set_power
    | set_written_product
set_written_product: set_expr CMD_TIMES _set_written | _set_written CMD_TIMES set_atom
set_eq: set_expr EQUAL _set_rhs2 | (set_minus | set_union | set_intersection | set_event | set_list | set_builder) EQUAL set_named
%extend relation: set_eq

// S5-21 p = \P(X_i = 1) \in [0, 1], X = x \in (0, 1), \mu = \E(X) \in \R, n p_n \to r \in (0, \infty):
// a chain of relations ending in a membership
chain_member: _expression ((_rel_op | LIM_APPROACH_SYM) _expression)+ (CMD_IN | CMD_NOTIN) (set_expr | named_power)
%extend relation: chain_member

// S5-22 \cov^2(X, Y), \cor^2(X, Y): a power of an operator, applied
op_power_applied: op_name CARET _expression_core (L_PAREN _op_args R_PAREN | L_BRACKET _op_args R_BRACKET)
%extend _function: op_power_applied

// S5-24 \mu\{x \in S: f(x) \ne g(x)\}, \lambda^n\{x\}, P(-\infty, x], P_n(a, b]: a measure applied to a
// written set (braces) or to a half-open interval
measure_set: (_one_letter_symbol | superscript) (set_list | set_builder | set_event)
halfopen_applied: _one_letter_symbol (L_PAREN _expression "," _expression R_BRACKET | L_BRACKET _expression "," _expression R_PAREN)
%extend _function: measure_set | halfopen_applied

// S5-25 (X_n: n \in \N_+), \left(a_n \theta^n: n \in \N\right), \{(x, y, z): 0 \le x \le y \le z \le 1\},
// \{(1, 1), (1, 2), (2, 2)\}: indexed families and sets of tuples
family: L_PAREN _expression COLON (_cond_item | cond_list) R_PAREN
%extend formula: family
%extend set_builder: L_BRACE_LITERAL tuple (COLON | BAR) _builder_cond R_BRACE_LITERAL
%extend set_list: L_BRACE_LITERAL tuple ("," tuple)* R_BRACE_LITERAL

// S5-26 (\R^n, \ms R^n, \lambda^n), (S, \ms S, \mu): measure spaces with a set constant as a component
%extend _tuple_item: set_const

// S5-18 \begin{cases} u, & 0 \lt u \lt 1 \\ 2 - u, & 1 \lt u \lt 2 \end{cases}: cases rows (value, condition),
// with a condition that is a relation, a membership, a list of them or text (\text{otherwise}).
// A text-mode argument is one terminal; the tree printer prints it from the source (T3).
CMD_BEGIN_CASES: /\\begin\s*\{cases\}/
CMD_END_CASES: /\\end\s*\{cases\}/
CMD_TEXTMODE: /\\(?:text|mbox|textrm)(?![A-Za-z])/
TEXT_BODY: /[^{}\s](?:[^{}]*[^{}\s])?/
text_group: CMD_TEXTMODE L_BRACE TEXT_BODY? R_BRACE
cases: CMD_BEGIN_CASES case_row (MATRIX_ROW_DELIM case_row)* MATRIX_ROW_DELIM? CMD_END_CASES
case_row: _expression ","? MATRIX_COL_DELIM _case_cond ","? | _expression ","?
_case_cond: _cond_item | cond_list | text_group | text_group (_cond_item | cond_list) | (_cond_item | cond_list) text_group
%extend _expression_func: cases

// S5-19 \begin{align} f(x) & = ... \\ & = ..., \quad x \in [0, \infty) \end{align} (also align*, aligned):
// rows of a relation chain with one alignment point, optionally followed by a list of conditions.
// The whole span is the environment, which the token form strips as an outer delimiter; the tree
// printer applies the same rule to its leaves (T2).
CMD_BEGIN_ALIGN: /\\begin\s*\{(?:align\*?|aligned)\}/
CMD_END_ALIGN: /\\end\s*\{(?:align\*?|aligned)\}/
align_env: CMD_BEGIN_ALIGN align_row (MATRIX_ROW_DELIM align_row)* MATRIX_ROW_DELIM? CMD_END_ALIGN
align_row: _expression? MATRIX_COL_DELIM _rel_op _align_rest
    | _expression _rel_op MATRIX_COL_DELIM _align_rest
_align_rest: _expression (_rel_op _expression)* ("," _list_item)* ","?
%extend any_value: align_env

// S5-27 (S5-23 refined: 23 made \P(E, X \in A) ambiguous with the list-membership convention)
// \P(E, X = x), \P(X \in A, E), \P[(X, Y) = (x, y)]: an operator's arguments mixing events and conditions;
// a membership may lead but never follow the expressions (a, b \in S already reads as a list membership)
mixed_list: _expression ("," _expression)* ("," _relation)+ | (_relation | member) ("," (_relation | member))* ("," _expression)+
tuple_rel: tuple EQUAL (tuple | _expression)
%extend _op_args: mixed_list | tuple_rel

// S5-28 C = [0, a), A = (-\infty, z], D_z = [0, z]: a set named by an interval with a bracket (a round pair
// is a tuple equation, S5-02)
_bracket_interval: L_BRACKET _expression "," _expression (R_PAREN | R_BRACKET) | L_PAREN _expression "," _expression R_BRACKET
interval_eq: set_named EQUAL _bracket_interval
%extend relation: interval_eq

// S5-29 (1 - n p_n / n)^n \to e^{-r}, a_n = b_n \to 0: \to in a chain of relations
%extend _rel_op: LIM_APPROACH_SYM

// S5-30 \bs 1_A, \bs 1(x + y \in A): a styled digit (the indicator)
%extend styled: (CMD_STYLE | GEN_STYLE) DIGIT
%extend _sym_base: styled

// S5-31 f^{*n}, P^{*n}: a convolution power
conv_power: _expression_func CARET L_BRACE (MUL | CMD_ASTERISK) _expression R_BRACE
%extend _expression_power: conv_power

// S5-33 (x, y) \mapsto f(x) g(y), (x, z) \mapsto (x, z - x): a map of tuples
%extend maps_to: tuple CMD_MAPSTO (_expression | eq | tuple) | _expression CMD_MAPSTO tuple

// S5-34 x_i \text{ for all } i \in \N_+, X_n \to X \text{ as } n \to \infty, \P(X_n \text{ does not converge to } X):
// values joined by a prose connective (a text-mode argument, S5-18), as a whole value, an operator's argument
// or a set-builder condition
text_join: _list_item (text_group _list_item)+ | _list_item text_group
%extend any_value: text_join
%extend _op_args: text_join
%extend _builder_cond: text_join

// S5-35 P(U \ge t), P(X_1 + X_2 = 0), \bs 1(X \gt x), \bs{1}(N \ge n): a symbol or an indicator applied to
// an event written as a relation or membership (an operator macro such as \P already takes one, S5-06/07)
rel_applied: (_one_letter_symbol | styled) (L_PAREN | L_BRACKET) (_cond_item | cond_list) (R_PAREN | R_BRACKET)
%extend _function: rel_applied
