 "kb.segment": {
  "columns": {
   "id": {
    "type": "int8",
    "not_null": true,
    "default": "identity always"
   },
   "rendition_id": {
    "type": "int8",
    "not_null": true,
    "default": null
   },
   "key": {
    "type": "text",
    "not_null": true,
    "default": null
   },
   "parent_id": {
    "type": "int8",
    "not_null": false,
    "default": null
   },
   "kind": {
    "type": "text",
    "not_null": true,
    "default": null
   },
   "ordinal": {
    "type": "int4",
    "not_null": true,
    "default": null
   },
   "depth": {
    "type": "int4",
    "not_null": true,
    "default": null
   },
   "start_offset": {
    "type": "int4",
    "not_null": true,
    "default": null
   },
   "end_offset": {
    "type": "int4",
    "not_null": true,
    "default": null
   },
   "text": {
    "type": "text",
    "not_null": true,
    "default": null
   },
   "ts_config": {
    "type": "regconfig",
    "not_null": true,
    "default": "'english'"
   },
   "attrs": {
    "type": "jsonb",
    "not_null": true,
    "default": "'{}'"
   },
   "parse_status": {
    "type": "text",
    "not_null": true,
    "default": "'ok'"
   },
   "parse_reason": {
    "type": "text",
    "not_null": false,
    "default": null
   }
  },
  "order": [
   "id",
   "rendition_id",
   "key",
   "parent_id",
   "kind",
   "ordinal",
   "depth",
   "start_offset",
   "end_offset",
   "text",
   "ts_config",
   "attrs",
   "parse_status",
   "parse_reason"
  ],
  "constraints": [
   [
    "check",
    "(parse_status = 'ok') = (parse_reason IS NULL)"
   ],
   [
    "check",
    "kind IN ('caption', 'details', 'document', 'email_message', 'figure', 'footnote', 'heading', 'list', 'list_item', 'math_display', 'math_inline', 'paragraph', 'quoted_block', 'section', 'sentence', 'signature', 'table', 'table_cell', 'table_row', 'unit')"
   ],
   [
    "check",
    "parse_status IN ('failed', 'ok', 'partial')"
   ],
   [
    "check",
    "start_offset <= end_offset"
   ],
   [
    "foreign key",
    [
     "parent_id"
    ],
    "kb.segment",
    [
     "id"
    ],
    null,
    null
   ],
   [
    "foreign key",
    [
     "rendition_id"
    ],
    "kb.rendition",
    [
     "id"
    ],
    "CASCADE",
    null
   ],
   [
    "primary key",
    [
     "id"
    ]
   ],
   [
    "unique",
    [
     "key"
    ]
   ]
  ],
  "indexes": {
   "segment_range": {
    "unique": false,
    "using": "btree",
    "params": [
     "rendition_id",
     "start_offset",
     "end_offset"
    ],
    "with": {},
    "where": null
   },
   "segment_kind": {
    "unique": false,
    "using": "btree",
    "params": [
     "rendition_id",
     "kind"
    ],
    "with": {},
    "where": null
   },
   "segment_bm25": {
    "unique": false,
    "using": "bm25",
    "params": [
     "text"
    ],
    "with": {
     "text_config": "'english'"
    },
    "where": "kind IN ('heading', 'list_item', 'math_display', 'paragraph') AND ts_config = CAST('english' AS regconfig)"
   }
  }
 },
