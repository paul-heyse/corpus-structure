  "sql": "WITH streamed_targets AS MATERIALIZED (\nSELECT record_id,native_address,native_address_stream_id FROM kb.pdf_record_native\nWHERE product_id=:build AND revision_id=:build AND native_address IS NULL)\nSELECT s.product_id,s.revision_id,s.reference_id,s.source_id,s.field_name,s.native_pointer,s.native_pointer_stream_id,COALESCE(s.target_id,CASE\n WHEN s.field_name IN ('source_cell_id','target_cell_id') THEN\n (SELECT n.record_id FROM kb.pdf_record_native n\n WHERE n.product_id=:build AND n.revision_id=:build AND n.native_type='GraphCell'\n AND n.scalars_json->>'cell_id'=s.native_pointer\n AND regexp_replace(n.native_address,'/cells/[0-9]+$','')=regexp_replace(\n (SELECT source.native_address FROM kb.pdf_record_native source\n WHERE source.product_id=:build AND source.revision_id=:build\n AND source.record_id=s.source_id),'/links/[0-9]+$',''))\n WHEN s.native_pointer_stream_id IS NULL THEN\n (SELECT target.record_id FROM (\n SELECT n.record_id FROM kb.pdf_record_native n\n WHERE n.product_id=:build AND n.revision_id=:build AND n.native_address=s.native_pointer\n UNION ALL\n SELECT n.record_id FROM streamed_targets n\n WHERE ops.pdf_reference_bytes_equal(:build,:build,n.native_address,n.native_address_stream_id,\n s.native_pointer,s.native_pointer_stream_id)\n ) target)\n ELSE\n (SELECT n.record_id FROM kb.pdf_record_native n\n WHERE n.product_id=:build AND n.revision_id=:build\n AND ops.pdf_reference_bytes_equal(:build,:build,n.native_address,n.native_address_stream_id,\n s.native_pointer,s.native_pointer_stream_id)) END) FROM ops.pdf_stage_reference s WHERE s.product_id=:build",
