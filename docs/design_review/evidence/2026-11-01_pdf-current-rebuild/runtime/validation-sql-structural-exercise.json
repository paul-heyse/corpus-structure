      "query": "SELECT EXISTS(WITH region_counts AS (\n SELECT pointer,count(*) count_ FROM kb.pdf_record_region\n WHERE product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' GROUP BY pointer\n ) SELECT FROM kb.pdf_record_access a LEFT JOIN region_counts counts ON counts.pointer=a.pointer\n WHERE a.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND a.revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND\n COALESCE(counts.count_,0)<>jsonb_array_length(COALESCE(a.native_json->'prov','[]'))) OR\n EXISTS(WITH page_sizes AS MATERIALIZED (\n SELECT pages.member_key,page_size.scalars_json AS dimensions\n FROM ops.pdf_record_document h JOIN kb.pdf_record_membership pages\n ON pages.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND pages.revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c'\n AND pages.parent_id=h.root_id AND pages.field_name='pages'\n LEFT JOIN kb.pdf_record_native page ON page.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND page.revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c'\n AND page.record_id=pages.record_id\n LEFT JOIN kb.pdf_record_native page_size ON page_size.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c'\n AND page_size.revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c'\n AND page_size.record_id=page.structure_json->'fields'->'size'->>'target'\n WHERE h.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND h.revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c'\n ) SELECT FROM kb.pdf_record_region r LEFT JOIN kb.pdf_record_access a ON a.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND a.revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND a.pointer=r.pointer\n LEFT JOIN LATERAL (SELECT a.native_json->'prov'->r.region_index::integer value) prov ON true\n LEFT JOIN page_sizes size ON size.member_key=r.page_no::text\n WHERE r.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND (r.revision_id<>'9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' OR a.pointer IS NULL OR prov.value IS NULL OR\n (prov.value->>'page_no')::bigint IS DISTINCT FROM r.page_no OR\n ops.pdf_projection_scalar_matches(to_jsonb(r.page_width),size.dimensions->'width') IS NOT TRUE OR\n ops.pdf_projection_scalar_matches(to_jsonb(r.page_height),size.dimensions->'height') IS NOT TRUE OR\n to_jsonb(r.left) IS DISTINCT FROM prov.value->'bbox'->'l' OR to_jsonb(r.top) IS DISTINCT FROM prov.value->'bbox'->'t' OR\n to_jsonb(r.right) IS DISTINCT FROM prov.value->'bbox'->'r' OR to_jsonb(r.bottom) IS DISTINCT FROM prov.value->'bbox'->'b' OR\n r.origin IS DISTINCT FROM CASE prov.value->'bbox'->>'coord_origin' WHEN 'TOPLEFT' THEN 'top_left' WHEN 'BOTTOMLEFT' THEN 'bottom_left' END))",
