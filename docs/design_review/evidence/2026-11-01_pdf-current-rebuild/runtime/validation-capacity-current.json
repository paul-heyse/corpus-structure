  "query": "SELECT EXISTS(SELECT FROM kb.pdf_record_access a WHERE a.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND\n (SELECT count(*) FROM kb.pdf_record_region r WHERE r.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND r.revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND r.pointer=a.pointer)<>jsonb_array_length(COALESCE(a.native_json->'prov','[]'))) OR\n EXISTS(SELECT FROM kb.pdf_record_region r LEFT JOIN kb.pdf_record_access a ON a.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND a.pointer=r.pointer\n LEFT JOIN LATERAL (SELECT a.native_json->'prov'->r.region_index::integer value) prov ON true\n LEFT JOIN ops.pdf_record_document h ON h.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND h.revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c'\n LEFT JOIN kb.pdf_record_membership pages ON pages.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND pages.revision_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND pages.parent_id=h.root_id AND pages.field_name='pages' AND pages.member_key=r.page_no::text\n LEFT JOIN kb.pdf_record_native page ON page.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND page.record_id=pages.record_id\n LEFT JOIN kb.pdf_record_native size ON size.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND size.record_id=page.structure_json->'fields'->'size'->>'target'\n WHERE r.product_id='9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' AND (r.revision_id<>'9372bc8fe8c89ac1d3b3a9ca57959846b81c6d44df78f09ad93402a56632056c' OR a.pointer IS NULL OR prov.value IS NULL OR\n (prov.value->>'page_no')::bigint IS DISTINCT FROM r.page_no OR\n ops.pdf_projection_scalar_matches(to_jsonb(r.page_width),size.scalars_json->'width') IS NOT TRUE OR\n ops.pdf_projection_scalar_matches(to_jsonb(r.page_height),size.scalars_json->'height') IS NOT TRUE OR\n to_jsonb(r.left) IS DISTINCT FROM prov.value->'bbox'->'l' OR to_jsonb(r.top) IS DISTINCT FROM prov.value->'bbox'->'t' OR\n to_jsonb(r.right) IS DISTINCT FROM prov.value->'bbox'->'r' OR to_jsonb(r.bottom) IS DISTINCT FROM prov.value->'bbox'->'b' OR\n r.origin IS DISTINCT FROM CASE prov.value->'bbox'->>'coord_origin' WHEN 'TOPLEFT' THEN 'top_left' WHEN 'BOTTOMLEFT' THEN 'bottom_left' END))",
