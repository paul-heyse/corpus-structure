 "frame": {
  "s1": {
   "locator": "special/Gamma.html@sentence:Suppose that \\(X_1\\)",
   "text": "Suppose that \\(X_1\\) and \\(X_2\\) are independent random variables, and that \\(X_i\\) has the gamma distribution with shape parameter \\(k_i \\in (0, \\infty)\\) and scale parameter \\(b \\in (0, \\infty)\\) for \\(i \\in \\{1, 2\\}\\)."
  },
  "s2": {
   "locator": "special/Gamma.html@sentence:Then \\(X_1",
   "text": "Then \\(X_1 + X_2\\) has the gamma distribution with shape parameter \\(k_1 + k_2\\) and scale parameter \\(b\\)."
  },
  "s3": {
   "locator": "special/Gamma.html@sentence:Recall that the MGF",
   "text": "Recall that the MGF of \\( X = X_1 + X_2 \\) is the product of the MGFs of \\( X_1 \\) and \\( X_2 \\), so \\[ \\E\\left(e^{t X}\\right) = \\frac{1}{(1 - b t)^{k_1}} \\frac{1}{(1 - b t)^{k_2}} = \\frac{1}{(1 - b t)^{k_1 + k_2}}, \\quad t \\lt \\frac{1}{b} \\]"
  }
 },
