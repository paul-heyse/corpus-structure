#!/usr/bin/env bash
# Explicit preparation. Installed toolchains are selected by the existing pin files.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
[[ $# -eq 0 ]] || { echo 'usage: bash scripts/setup-env' >&2; exit 2; }
unset VIRTUAL_ENV UV_NO_SYNC UV_FROZEN UV_PYTHON UV_PROJECT UV_WORKING_DIR UV_NO_PROJECT

export UV_PROJECT_ENVIRONMENT="$PWD/.venv"
uv sync --locked --inexact

